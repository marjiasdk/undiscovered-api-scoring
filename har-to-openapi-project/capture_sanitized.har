"name\":\"Master Table\",\"showLastUpdate\":false,\"noDataState\":{\"verticalAlignment\":\"middle\",\"showTopCaption\":true,\"showBottomCaption\":true},\"noFilterState\":{\"verticalAlignment\":\"middle\",\"showTopCaption\":true,\"showBottomCaption\":true},\"datasets\":[{\"type\":\"serviceDataset\",\"name\":\"main\",\"dataSource\":{\"type\":\"layerDataSource\",\"itemId\":\"{{HEX_ID}}\",\"layerId\":0},\"groupByFields\":[],\"orderByFields\":[\"disease ASC\"],\"statisticDefinitions\":[],\"maxFeatures\":1000,\"clientSideStatistics\":false,\"outFields\":[\"*\"],\"returnDistinctValues\":false,\"allowSourceDownload\":false,\"allowSummaryDownload\":false}],\"arcadeEnabled\":true,\"expression\":\"// Status Color\\r\\nvar statusColor = Decode($datapoint.MarginTag,\\r\\n    'No Change', ['#fab235', '#fab235'],\\r\\n    'Decrease', ['#379f3e', '#379f3e'],\\r\\n    'Increase', ['#bb2048', '#bb2048'],\\r\\n    \\r\\n    ''\\r\\n    )\\r\\n\\r\\n\\r\\n\\r\\nreturn {\\r\\n  cells: {\\r\\n    disease: {\\r\\n      displayText : $datapoint.disease,\\r\\n      textColor: '',\\r\\n      backgroundColor: '',\\r\\n      textAlign: 'left',\\r\\n      iconName: $datapoint.MarginTag,\\r\\n      iconAlign: '',\\r\\n      iconColor: statusColor[0],\\r\\n      iconOutlineColor: statusColor[0]\\r\\n    },\\r\\n\\t\\t\\r\\n    total: {\\r\\n      displayText : $datapoint.total,\\r\\n      textColor: '',\\r\\n      backgroundColor: '',\\r\\n      textAlign: 'right',\\r\\n      iconName: '',\\r\\n      iconAlign: '',\\r\\n      iconColor: '',\\r\\n      iconOutlineColor: ''\\r\\n    },\\r\\n\\t\\t\\r\\n  }\\r\\n}\",\"events\":[{\"type\":\"selectionChanged\",\"actions\":[{\"targets\":[{\"targetId\":\"79e85945-8fee-41a0-b68c-117118ca55b4#main\",\"by\":\"whereClause\",\"requiresSelection\":false},{\"targetId\":\"8b385f7b-0289-4385-9ab9-9259da5cad78#reference\",\"by\":\"whereClause\",\"requiresSelection\":false},{\"targetId\":\"8b385f7b-0289-4385-9ab9-9259da5cad78#main\",\"by\":\"whereClause\",\"requiresSelection\":false},{\"targetId\":\"feda7af6-6485-43b6-b832-a47d661b2232#main\",\"by\":\"whereClause\",\"requiresSelection\":false},{\"targetId\":\"feda7af6-6485-43b6-b832-a47d661b2232#reference\",\"by\":\"whereClause\",\"requiresSelection\":false},{\"targetId\":\"6774b1e7-930f-435d-9168-99459f161256#main\",\"by\":\"whereClause\",\"requiresSelection\":false},{\"targetId\":\"582ff65e-489e-4053-a6d5-bbbf4838fb1a#main\",\"by\":\"whereClause\",\"requiresSelection\":false},{\"targetId\":\"92c9f6c6-f6bc-4f27-b223-2f0f38355d20#main\",\"by\":\"whereClause\",\"requiresSelection\":false,\"fieldMap\":[{\"sourceName\":\"disease\",\"targetName\":\"disease\"}]},{\"targetId\":\"a7e053d3-e694-4138-a1e2-cda0633b395e#main\",\"by\":\"whereClause\",\"requiresSelection\":false,\"fieldMap\":[{\"sourceName\":\"disease\",\"targetName\":\"Disease\"}]},{\"targetId\":\"29f9c71d-6dbb-49c4-888f-d1434d9783c3#main\",\"by\":\"whereClause\",\"requiresSelection\":false,\"fieldMap\":[{\"sourceName\":\"disease\",\"targetName\":\"Disease\"}]},{\"targetId\":\"b4e27e03-6391-476c-9584-247f9dfe10a1#main\",\"by\":\"whereClause\",\"requiresSelection\":false,\"fieldMap\":[{\"sourceName\":\"disease\",\"targetName\":\"disease\"}]},{\"targetId\":\"35fa65f7-9d2e-476a-bf8e-c474e17f71b7#main\",\"by\":\"whereClause\",\"requiresSelection\":false}],\"type\":\"filter\"}]}],\"type\":\"tableWidget\",\"dataSettings\":{\"type\":\"features\",\"valueFields\":[\"disease\",\"total\"]},\"tableSettings\":{\"layout\":\"fit-data-stretch\",\"scale\":\"medium\",\"hoverText\":true,\"rowStriping\":false,\"selectionMode\":\"single\",\"verticalGrid\":{\"thickness\":1},\"horizontalGrid\":{\"thickness\":1},\"headerSettings\":{\"textColor\":\"#c9c9c9\",\"backgroundColor\":\"#3c5e7e\",\"rule\":{\"thickness\":3}}},\"columnSettings\":[{\"title\":\"Select Disease\",\"fieldName\":\"disease\",\"isBold\":false,\"isItalic\":false,\"isUnderlined\":false},{\"title\":\"Weekly Cases\",\"fieldName\":\"total\",\"isBold\":false,\"isItalic\":false,\"isUnderlined\":false}],\"iconInfos\":[{\"name\":\"Increase\",\"align\":\"left\",\"icon\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"icon \\\" role=\\\"button\\\" viewBox=\\\"0 0 16 16\\\"><path d=\\\"M7.5 5.202L3 9.702V8.288l4.5-4.5 4.5 4.5v1.414z\\\"/><path d=\\\"M7.5 0C3.366 0 0 3.364 0 7.5S3.365 15 7.5 15c4.136 0 7.5-3.364 7.5-7.5S11.636 0 7.5 0zm.001 14C3.916 14 1 11.084 1 7.5S3.916 1 7.501 1C11.085 1 14 3.916 14 7.5S11.085 14 7.501 14z\\\"/></svg>\"},{\"name\":\"Decrease\",\"align\":\"left\",\"icon\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"icon \\\" role=\\\"button\\\" viewBox=\\\"0 0 16 16\\\"><path d=\\\"M7.5 9.798L3 5.298v1.414l4.5 4.5 4.5-4.5V5.298z\\\"/><path d=\\\"M7.5 0C3.366 0 0 3.364 0 7.5S3.365 15 7.5 15c4.136 0 7.5-3.364 7.5-7.5S11.636 0 7.5 0zm.001 14C3.916 14 1 11.084 1 7.5S3.916 1 7.501 1C11.085 1 14 3.916 14 7.5S11.085 14 7.501 14z\\\"/></svg>\"},{\"name\":\"No Change\",\"align\":\"left\",\"icon\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"icon \\\" role=\\\"button\\\" viewBox=\\\"0 0 16 16\\\"><path d=\\\"M3 7h9v1H3z\\\"/><path d=\\\"M7.5 0C3.366 0 0 3.364 0 7.5S3.365 15 7.5 15c4.136 0 7.5-3.364 7.5-7.5S11.636 0 7.5 0zm.001 14C3.916 14 1 11.084 1 7.5S3.916 1 7.501 1C11.085 1 14 3.916 14 7.5S11.085 14 7.501 14z\\\"/></svg>\"}],\"editingEnabled\":false,\"editColumnPlacement\":\"end\"},{\"id\":\"8b385f7b-0289-4385-9ab9-9259da5cad78\",\"name\":\"Indicator Week Total\",\"bottomCaption\":\"<h5 style=\\\"text-align:center\\\">(percentage/numeric change since last week)</h5>\\n\",\"showLastUpdate\":false,\"noDataState\":{\"verticalAlignment\":\"middle\",\"showTopCaption\":true,\"showBottomCaption\":true},\"noFilterState\":{\"verticalAlignment\":\"middle\",\"showTopCaption\":true,\"showBottomCaption\":true},\"datasets\":[{\"type\":\"serviceDataset\",\"name\":\"main\",\"dataSource\":{\"type\":\"layerDataSource\",\"itemId\":\"{{HEX_ID}}\",\"layerId\":0},\"groupByFields\":[],\"orderByFields\":[\"total ASC\"],\"statisticDefinitions\":[],\"maxFeatures\":1,\"clientSideStatistics\":false,\"outFields\":[\"*\"],\"returnDistinctValues\":false,\"allowSourceDownload\":false,\"allowSummaryDownload\":false},{\"type\":\"serviceDataset\",\"name\":\"reference\",\"dataSource\":{\"type\":\"layerDataSource\",\"itemId\":\"{{HEX_ID}}\",\"layerId\":0},\"groupByFields\":[],\"orderByFields\":[],\"statisticDefinitions\":[{\"onStatisticField\":\"total\",\"statisticType\":\"sum\",\"outStatisticFieldName\":\"SUM_TOTAL\"}],\"clientSideStatistics\":false,\"outFields\":[\"*\"],\"returnDistinctValues\":false,\"allowSourceDownload\":false,\"allowSummaryDownload\":false}],\"arcadeEnabled\":true,\"expression\":\"// Status Color\\r\\nvar statusColor = Decode($datapoint.MarginTag,\\r\\n    'No Change', ['#fab235', '#fab235'],\\r\\n    'Decrease', ['#379f3e', '#379f3e'],\\r\\n    'Increase', ['#bb2048', '#bb2048'],\\r\\n    ''\\r\\n)\\r\\n\\r\\n// Percent change from previous period\\r\\nvar percentChange = 100 * ($datapoint.difference_prev_week / $datapoint.Prev_week_value);\\r\\n\\r\\n// Round % change\\r\\nvar RoundChange = Round(percentChange, 1);\\r\\n\\r\\nvar result = RoundChange;\\r\\nif (isNaN(result)) {\\r\\n  result = 0;\\r\\n}\\r\\n\\r\\n// style when no significant increase\\r\\nif (percentChange < 0) {\\r\\n  return {\\r\\n    topTextColor: '#262626',\\r\\n    topTextOutlineColor: '',\\r\\n    topText: 'Number this week',\\r\\n    topTextMaxSize: 'medium',\\r\\n    middleText: $datapoint.total,\\r\\n    middleTextMaxSize: 'large',\\r\\n    middleTextColor: '#262626',\\r\\n    middleTextOutlineColor: '',\\r\\n    bottomText: result + '% or ' + $datapoint.difference_prev_week,\\r\\n    bottomTextMaxSize: 'medium',\\r\\n    bottomTextColor: statusColor[0],\\r\\n    bottomTextOutlineColor: '',\\r\\n    iconName: $datapoint.MarginTag,\\r\\n    iconColor: statusColor[0],\\r\\n    iconOutlineColor: statusColor[0],\\r\\n    iconAlign: 'right',\\r\\n  };\\r\\n} else if (percentChange > 0) {\\r\\n  // style when significant increase\\r\\n  return {\\r\\n    topTextColor: '#262626',\\r\\n    topTextOutlineColor: '',\\r\\n    topText: 'Number this week',\\r\\n    topTextMaxSize: 'medium',\\r\\n    middleText: $datapoint.total,\\r\\n    middleTextMaxSize: 'large',\\r\\n    middleTextColor: '#262626',\\r\\n    middleTextOutlineColor: '',\\r\\n    bottomText: result + '% or +' + $datapoint.difference_prev_week,\\r\\n    bottomTextMaxSize: 'medium',\\r\\n    bottomTextColor: statusColor[0],\\r\\n    bottomTextOutlineColor: '',\\r\\n    iconName: $datapoint.MarginTag,\\r\\n    iconColor: statusColor[0],\\r\\n    iconOutlineColor: statusColor[0],\\r\\n    iconAlign: 'right',\\r\\n  };\\r\\n} else {\\r\\n  // style when extreme increase (percentChange >= threshold2)\\r\\n  return {\\r\\n    topTextColor: '#262626',\\r\\n    topTextOutlineColor: '',\\r\\n    topText: 'Number this week',\\r\\n    topTextMaxSize: 'medium',\\r\\n    middleText: $datapoint.total,\\r\\n    middleTextMaxSize: 'large',\\r\\n    middleTextColor: '#262626',\\r\\n    middleTextOutlineColor: '',\\r\\n    bottomText: result + '% or ' + $datapoint.difference_prev_week,\\r\\n    bottomTextMaxSize: 'medium',\\r\\n    bottomTextColor: statusColor[0],\\r\\n    bottomTextOutlineColor: '',\\r\\n    iconName: $datapoint.MarginTag,\\r\\n     iconColor: statusColor[0],\\r\\n    iconOutlineColor: statusColor[0],\\r\\n    iconAlign: 'right',\\r\\n    }\\r\\n}\\r\\n\",\"arcadeRefreshEnabled\":false,\"type\":\"indicatorWidget\",\"defaultSettings\":{\"topSection\":{\"fontSize\":80,\"textInfo\":{}},\"middleSection\":{\"fontSize\":160,\"textInfo\":{\"text\":\"{calculated/value}\"}},\"bottomSection\":{\"fontSize\":80,\"textInfo\":{}}},\"comparison\":\"statistic\",\"valueField\":\"ObjectId\",\"valueFormat\":{\"name\":\"value\",\"prefix\":true,\"style\":\"decimal\",\"useGrouping\":true,\"maximumFractionDigits\":1},\"percentageFormat\":{\"name\":\"percentage\",\"prefix\":false,\"style\":\"percent\",\"useGrouping\":true},\"rat