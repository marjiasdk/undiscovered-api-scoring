            "text": "{\n  \"modal\": {\n    \"dismiss\": \"Do not show this again\",\n    \"close\": \"Close\"\n  },\n  \"notice\": {\n    \"n001\": {\n      \"title\": \"Test Notice\",\n      \"message\": \"This is the body of the test notice\",\n      \"actions\": [\n        {\n          \"text\": \"Read the blog\"\n        }\n      ]\n    },\n    \"20240220-hosted-downloads-1\": {\n      \"title\": \"Switch to the updated download experience\",\n      \"message\": \"For additional formats and speed and performance improvements, enable \\\"extract\\\" on this item's service.\"\n    },\n    \"20240220-hosted-downloads-2\": {\n      \"title\": \"Download enhancements are here!\",\n      \"message\": \"Enhancements to downloads on your Hub sites include support for hosted downloads, an updated look & feel for download cards, and a new progress bar for downloads.\",\n      \"actions\": [\n        {\n          \"text\": \"Learn more\"\n        }\n      ]\n    },\n    \"20240220-hosted-downloads-3\": {\n      \"title\": \"Hosted downloads are here!\",\n      \"message\": \"Hosted downloads help improve performance when downloading content. To enable hosted downloads, be sure to allow Extract Capabilities below.\",\n      \"actions\": [\n        {\n          \"text\": \"Learn more\"\n        }\n      ]\n    },\n    \"20240710-slow-service-warning\": {\n      \"title\": \"Service interruption\",\n      \"message\": \"Communication with the service is taking longer than expected. This may affect your access to downloads and map functionality.\"\n    },\n    \"20240710-unreachable-service-error\": {\n      \"title\": \"Service unavailable\",\n      \"message\": \"We are unable to contact the host service. Downloads and map functionality are currently unavailable for this item.\"\n    },\n    \"20240807-auth-required-status\": {\n      \"title\": \"Service status unknown\",\n      \"message\": \"We are unable to access the secure service as it requires additional authorization. Downloads and map functionality are currently unavailable for the item.\"\n    },\n    \"20240805-private-downloads-unavailable-ago-error\": {\n      \"title\": \"Downloads are unavailable\",\n      \"message\": \"To download content, the Export Data setting must be enabled on ArcGIS Online. Please contact the item owner to enable this setting.\"\n    },\n    \"20240805-private-downloads-unavailable-enterprise-error\": {\n      \"title\": \"Downloads are unavailable\",\n      \"message\": \"To download content, the Export Data setting must be enabled on ArcGIS Enterprise. Please contact the item owner to enable this setting.\"\n    },\n    \"20240819-download-formats-disabled\": {\n      \"title\": \"Downloads have been disabled\",\n      \"message\": \"To download content for this item, please contact the item owner.\"\n    },\n    \"20241104-about-feeds-notice\": {\n      \"message\": \"Make your public open data easily accessible and reusable with Hub feeds.\",\n      \"actions\": [\n        {\n          \"text\": \"Learn about Hub feeds\",\n          \"ariaLabel\": \"Learn about Hub feeds, Opens in new tab\"\n        }\n      ]\n    },\n    \"20250311-channel-edit-warning\": {\n      \"message\": \"Edits will affect everywhere this channel is used\"\n    },\n    \"20250311-channel-permissions-info\": {\n      \"message\": \"Set who can view, contribute, moderate, and manage posts in this channel.\",\n      \"actions\": [\n        {\n          \"text\": \"Read more about permissions\",\n          \"ariaLabel\": \"Read more about permissions.\"\n        }\n      ]\n    },\n    \"20250425-image-picker-notice\": {\n      \"message\": \"Upload your own thumbnail to replace the default.\"\n    },\n    \"20250429-enhanced-events-view-notice\": {\n      \"title\": \"Caution: Switch to enhanced events\",\n      \"message\": \"In the future, older events will no longer be editable. This notice is only visible to event editors.\"\n    },\n    \"20250430-enhanced-events-editor-notice\": {\n      \"title\": \"Caution: Switch to enhanced events\",\n      \"message\": \"In the future, older events will no longer be editable. Creating enhanced events is recommended.\"\n    },\n    \"20250506-enhanced-events-card-notice\": {\n      \"title\": \"Caution: Switch to enhanced events\",\n      \"message\": \"In the future, older events will no longer be editable. Create and share enhanced events with the Events card.\"\n    },\n    \"20250506-enhanced-events-card-notice-no-icon\": {\n      \"title\": \"Caution: Switch to enhanced events\",\n      \"message\": \"In the future, older events will no longer be editable. Create and share enhanced events with the Events card.\"\n    },\n    \"page-migration-already-shared-to-groups\": {\n      \"message\": \"This page is already shared with some catalog groups.\"\n    },\n    \"202506-workspaces-welcome\": {\n      \"title\": \"Welcome to workspaces\",\n      \"message\": {\n        \"p1\": \"Workspaces are now the default way to manage information in ArcGIS Hub (after a year in beta). They include the familiar workflows you rely on every day and many new features to help you:\",\n        \"sections\": [\n          {\n            \"heading\": \"Build sites and pages\",\n            \"bullets\": [\n              \"Create a website (site) with a domain different from the title from the start.\",\n              \"Configure a custom slug for a page to be used across all sites where it displays.\"\n            ]\n          },\n          {\n            \"heading\": \"Manage datasets\",\n            \"bullets\": [\n              \"Schedule automated content, metadata, and cached download file updates for eligible datasets.\",\n              \"Hide and reorder download format options for eligible datasets.\"\n            ]\n          },\n          {\n            \"heading\": \"Track and share progress on your objectives (ArcGIS Hub Premium only)\",\n            \"bullets\": [\n              \"Leverage initiatives and projects to organize information and people around common goals.\",\n              \"Build a search catalog for initiatives and projects using additional filters and multiple collections.\"\n            ]\n          },\n          {\n            \"heading\": \"Boost collaboration with event catalogs and discussions (ArcGIS Hub Premium only)\",\n            \"bullets\": [\n              \"Build a catalog of enhanced events on your sites, initiatives, and projects.\",\n              \"Assign new roles in a discussion to clearly define who can participate, moderate, or manage posts.\"\n            ]\n          }\n        ],\n        \"p2\": \"We are excited to add enhancements to workspaces in the coming months. This includes the ability to migrate your site catalogs and leverage the additional catalog functionality available on initiatives and projects.\",\n        \"p3\": \"You can temporarily turn off workspaces to use the classic edit mode, if needed. Re-enable workspaces at any time from your user settings in ArcGIS Hub.\",\n        \"docLink\": \"Open the ArcGIS Hub documentation​\"\n      },\n      \"closeButtonLabel\": \"Use workspaces\",\n      \"actions\": [\n        {\n          \"text\": \"Go to settings\",\n          \"ariaLabel\": \"Go to settings\"\n        }\n      ]\n    },\n    \"202506-workspaces-opt-in\": {\n      \"title\": \"Opt-in to workspaces\",\n      \"message\": {\n        \"p1\": \"Workspaces are turned off for your account. You can use the classic edit mode for a temporary period. You may lose access to certain features for managing content, if working with others who are using workspaces and they enable future enhancements.\",\n        \"p2\": \"If you turn off workspaces for your account, you cannot access various current and future enhancements, such as the ability to:\",\n        \"bullets\": [\n          \"Schedule automated content, metadata, and cached download file updates for eligible datasets.\",\n          \"Hide and reorder download format options for eligible datasets\",\n          \"Create enhanced events to bring people together (ArcGIS Hub Premium only)\",\n          \"Extend your search catalog with new filters and collection configurations.\"\n        ],\n        \"p3\": \"You can re-enable workspaces at any time from your user settings in ArcGIS Hub.\"\n      },\n      \"actions\": [\n        {\n          \"text\": \"Go to settings\",\n          \"ariaLabel\": \"Go to settings\"\n        }\n      ]\n    },\n    \"testing-arcgis-hub-access-gate\": {\n      \"title\": \"Testing out the ArcGIS Hub Access Gate\",\n      \"message\": {\n        \"p1\": \"This is a test notice for the ArcGIS Hub Access Gate. It is used to control access to content based on user roles and permissions.\",\n        \"p2\": \"In this example, the only user who can see the gated content is `qa_pre_a_hub_admin`.\",\n        \"p3\": \"Yes, in this example the two buttons below will close the notice, but in a real-world scenario, the buttons would lead to different actions based on the user's role and permissions.\"\n      },\n      \"actions\": [\n        {\n          \"text\": \"Secondary action\",\n          \"ariaLabel\": \"Secondary action\"\n        },\n        {\n          \"text\": \"Primary action\",\n          \"ariaLabel\": \"Primary action\"\n        }\n      ]\n    },\n    \"20250708-migrated-catalog\": {\n      \"title\": \"Your site catalog has been upgraded\",\n      \"message\": {\n        \"p1\": \"Your administrator has upgraded the site catalog to unlock new features. To access this functionality, enable workspaces in your settings.\"\n      },\n      \"actions\": [\n        {\n          \"text\": \"Return to layout editor\",\n          \"ariaLabel\": \"Return to layout editor\"\n        },\n        {\n          \"text\": \"Go to settings\",\n          \"ariaLabel\": \"Go to settings\"\n        }\n      ]\n    },\n    \"20250728-workspace-catalog-popover\": {\n      \"title\": \"Introducing Catalogs\",\n      \"message\": \"The catalog specifies and organizes what visitors can search.\"\n    }\n  }\n}\n"
          },
